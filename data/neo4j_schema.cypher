CREATE CONSTRAINT c_company_id IF NOT EXISTS FOR (n:Company) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_report_id IF NOT EXISTS FOR (n:Report) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_chunk_id IF NOT EXISTS FOR (n:Chunk) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_person_id IF NOT EXISTS FOR (n:Person) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_product_id IF NOT EXISTS FOR (n:Product) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_sector_id IF NOT EXISTS FOR (n:Sector) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_financial_metric_id IF NOT EXISTS FOR (n:FinancialMetric) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_event_id IF NOT EXISTS FOR (n:Event) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_date_id IF NOT EXISTS FOR (n:Date) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT c_company_ticker IF NOT EXISTS FOR (n:Company) REQUIRE n.ticker IS UNIQUE;
CREATE CONSTRAINT c_report_document_id IF NOT EXISTS FOR (n:Report) REQUIRE n.document_id IS UNIQUE;
CREATE CONSTRAINT c_chunk_chunk_id IF NOT EXISTS FOR (n:Chunk) REQUIRE n.chunk_id IS UNIQUE;
CREATE CONSTRAINT c_date_value IF NOT EXISTS FOR (n:Date) REQUIRE n.value IS UNIQUE;
CREATE INDEX idx_report_lookup IF NOT EXISTS FOR (n:Report) ON (n.ticker, n.year, n.report_type, n.language);
CREATE INDEX idx_chunk_citation IF NOT EXISTS FOR (n:Chunk) ON (n.report_id, n.page_number);
CREATE INDEX idx_person_name IF NOT EXISTS FOR (n:Person) ON (n.normalized_name);
CREATE INDEX idx_product_name IF NOT EXISTS FOR (n:Product) ON (n.normalized_name);
CREATE INDEX idx_sector_name IF NOT EXISTS FOR (n:Sector) ON (n.normalized_name);
CREATE INDEX idx_metric_lookup IF NOT EXISTS FOR (n:FinancialMetric) ON (n.company_id, n.metric_key, n.date_id);
CREATE INDEX idx_metric_source IF NOT EXISTS FOR (n:FinancialMetric) ON (n.source_chunk_id);
CREATE INDEX idx_event_lookup IF NOT EXISTS FOR (n:Event) ON (n.company_id, n.date_id, n.event_type);
CREATE FULLTEXT INDEX idx_entity_fulltext IF NOT EXISTS FOR (n:Company|Person|Product|Sector|Event) ON EACH [n.name, n.title, n.aliases, n.description];
CREATE INDEX idx_evidence_report IF NOT EXISTS FOR ()-[r:EVIDENCED_BY]-() ON (r.source_report_id);
CREATE INDEX idx_role_name IF NOT EXISTS FOR ()-[r:HOLDS_ROLE_AT]-() ON (r.role);
