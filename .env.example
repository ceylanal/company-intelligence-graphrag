# Application Settings
# Supported: development, test, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
GIT_COMMIT_SHA=unknown
HEALTH_TIMEOUT_SECONDS=3
REQUEST_MAX_BYTES=1048576
API_KEY=

# Qdrant Connection Settings (Local or Cloud)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=company_documents
QDRANT_USE_CLOUD=false

# Neo4j Connection Settings (Local or Cloud Aura)
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-local
NEO4J_DATABASE=neo4j
NEO4J_USE_CLOUD=false

# LLM Provider & Key
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_BASE_SECONDS=0.25

# Research guardrails
MAX_CONCURRENT_RESEARCH_TASKS=2
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RESEARCH_MAX_DURATION_SECONDS=300
RESEARCH_MAX_MODEL_CALLS=12
RESEARCH_MAX_INPUT_TOKENS=64000
RESEARCH_MAX_OUTPUT_TOKENS=16000
RESEARCH_MAX_TOTAL_TOKENS=80000
RESEARCH_MAX_COST_USD=

# Versioned public metadata (never put secrets in version fields)
PROMPT_REGISTRY_PATH=config/prompts.yaml
RUN_MANIFEST_DIR=artifacts/run_manifests
QDRANT_COLLECTION_VERSION=1.0.0
GRAPH_SCHEMA_VERSION=1.0.0
RETRIEVAL_VERSION=1.0.0
WORKFLOW_VERSION=1.0.0
CITATION_VALIDATION_VERSION=1.0.0
EVAL_DATASET_VERSION=1.0.0
EVAL_RUBRIC_VERSION=1.0.0

# Optional fail-open telemetry
TELEMETRY_ENABLED=false
TELEMETRY_EXPORTER=none
OTEL_SERVICE_NAME=company-graphrag-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OPIK_ENABLED=false
OPIK_API_KEY=
OPIK_WORKSPACE=
TELEMETRY_CAPTURE_PROMPTS=false
